# Web app (Next.js)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Database (user sync + preferences)
DATABASE_URL="postgresql://jobmatch:jobmatch_dev@localhost:5434/jobmatch?schema=public"

# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Optional: Clerk paths (defaults match our routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# Clerk webhooks (Dashboard → Webhooks → endpoint URL + signing secret)
# Local: use Clerk CLI or a tunnel (ngrok) pointing to http://localhost:3000/api/webhooks/clerk
# CLERK_WEBHOOK_SECRET="whsec_..."

# Resume storage (ADR-010) — local filesystem by default
UPLOAD_DIR="./uploads"

# Optional CDN base URL for resume downloads (fronts your object storage, e.g. CloudFront).
# When set (and resume.storageProvider === 's3'), the download endpoint streams the file from this CDN.
# RESUME_CDN_BASE_URL="https://cdn.example.com/"

# AI service (Module 4 — resume parse)
AI_SERVICE_URL="http://localhost:8000"
# Upper bound for a single parse call. Raise this when LLM enrichment is enabled.
AI_SERVICE_TIMEOUT_MS="120000"

# Background jobs. With REDIS_URL set, resume parsing runs in the API's queue
# worker; without it, parsing falls back to running inline in the request.
REDIS_URL="redis://localhost:6379"
# Force inline execution even when Redis is available: QUEUE_DRIVER="inline"

# Optional S3-compatible storage (Supabase Storage / MinIO / AWS)
# When S3_BUCKET + keys are set, uploads go to object storage instead of disk.
# S3_BUCKET="resumes"
# S3_REGION="eu-west-1"
# S3_ENDPOINT="https://<project>.storage.supabase.co/storage/v1/s3"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_FORCE_PATH_STYLE="true"

# Email (Module 17) — Resend in prod; without a key, emails log to the console in dev.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="AI JobMatch Copilot <onboarding@resend.dev>"
# APP_URL is used for deep links when NEXT_PUBLIC_APP_URL is unset (workers).
# APP_URL="http://localhost:3000"

# Billing (Module 19) — Lemon Squeezy (global) + Paystack (Nigeria)
# LEMON_SQUEEZY_API_KEY="..."
# LEMON_SQUEEZY_STORE_ID="12345"
# LEMON_SQUEEZY_PRO_VARIANT_ID="12345"           # subscription variant
# LEMON_SQUEEZY_PRO_ONETIME_VARIANT_ID="12346"   # optional one-time variant
# LEMON_SQUEEZY_TEAM_VARIANT_ID="12347"          # Team subscription variant
# LEMON_SQUEEZY_TEAM_ONETIME_VARIANT_ID="12348"  # optional Team one-time variant
# LEMON_SQUEEZY_WEBHOOK_SECRET="..."
# PAYSTACK_SECRET_KEY="sk_test_..."
# PAYSTACK_PUBLIC_KEY="pk_test_..."
# PAYSTACK_PRO_PLAN_CODE="PLN_..."          # preferred for subscriptions
# PAYSTACK_PRO_AMOUNT_KOBO="500000"         # one-time / fallback amount (e.g. ₦5,000)
# PAYSTACK_TEAM_PLAN_CODE="PLN_..."         # Team subscription plan
# PAYSTACK_TEAM_AMOUNT_KOBO="1500000"       # Team one-time / fallback amount

# Admin Portal (Module 20) — comma-separated emails promoted to role=admin on first /admin hit
# ADMIN_EMAILS="you@example.com"

# Meilisearch (Wave 2) — optional keyword search upgrade; falls back to Postgres FTS
# MEILI_HOST="http://127.0.0.1:7700"
# MEILI_API_KEY="jobmatch_meili_dev_key"
# MEILI_INDEX_JOBS="jobs"
