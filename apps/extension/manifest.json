{
  "manifest_version": 3,
  "name": "JobMatch Copilot Autofill",
  "description": "Autofill employer job applications from your JobMatch profile. Never auto-submits.",
  "version": "0.1.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "autofill@jobmatch.copilot",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_title": "JobMatch Autofill",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://jobmatch-web.onrender.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://jobmatch-web.onrender.com/*",
        "https://*.onrender.com/*"
      ],
      "js": ["content/connect-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "http://localhost:3000/*",
        "https://jobmatch-web.onrender.com/*"
      ],
      "js": ["content/fill.js", "content/drawer.js"],
      "run_at": "document_idle"
    }
  ]
}
