# API (NestJS)
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Database — shared with packages/database
DATABASE_URL="postgresql://jobmatch:jobmatch_dev@localhost:5434/jobmatch?schema=public"

# Background jobs (BullMQ). The resume-parse worker starts with the API process.
REDIS_URL="redis://localhost:6379"
# QUEUE_DRIVER="inline"  # force inline even when Redis is available

# AI service
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TIMEOUT_MS="120000"

# Clerk — must match web app (JWT verification)
CLERK_SECRET_KEY="sk_test_..."

# Resume storage (ADR-010). Relative paths resolve from the monorepo root so the
# web app and the API worker share the same files.
UPLOAD_DIR="./uploads"

# Optional CDN base URL for resume downloads (fronts your object storage, e.g. CloudFront).
# When set (and resume.storageProvider === 's3'), the download endpoint streams the file from this CDN.
# RESUME_CDN_BASE_URL="https://cdn.example.com/"

# Production deploy: see docs/DEPLOY.md and .env.production.example
# CORS_ORIGIN must list your real web origin(s), comma-separated.
# JOB_INGEST_ENABLED should stay false when using GitHub Actions ingest.

# Optional S3-compatible storage (Supabase Storage / MinIO / AWS)
# S3_BUCKET="resumes"
# S3_REGION="eu-west-1"
# S3_ENDPOINT="https://<project>.storage.supabase.co/storage/v1/s3"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_FORCE_PATH_STYLE="true"

# Email (Module 17) — used by queue workers for transactional product emails.
# Without RESEND_API_KEY, messages print to the API console in development.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="AI JobMatch Copilot <onboarding@resend.dev>"
# Deep links in emails (should match the web app origin).
APP_URL="http://localhost:3000"
# APPLICATION_REMINDERS_ENABLED="false"  # disable idle-pipeline reminder sweep
# APPLICATION_REMINDER_IDLE_DAYS="7"
# APPLICATION_REMINDER_INTERVAL_MS="21600000"  # 6 hours
# Job alerts (Module 5) — emails new matches for alert-enabled saved searches.
# JOB_ALERTS_ENABLED="false"
# JOB_ALERT_INTERVAL_MS="21600000"       # sweep cadence (default 6h)
# JOB_ALERT_MIN_INTERVAL_HOURS="20"      # per-search cooldown
# JOB_ALERT_LOOKBACK_DAYS="3"            # first-run lookback when lastAlertAt is null
# Weekly digest (Wave 1) — activity summary for emailWeeklyDigest users.
# WEEKLY_DIGEST_ENABLED="false"
# WEEKLY_DIGEST_INTERVAL_MS="86400000"   # sweep cadence (default 24h)
# WEEKLY_DIGEST_MIN_INTERVAL_DAYS="6.5"  # per-user cooldown (~weekly)

# Job ingestion (Wave 2) — public providers run by default via `pnpm jobs:ingest`
# Optional keyed providers — see docs/JOB_INGEST_KEYS.md
# ADZUNA_APP_ID="..."
# ADZUNA_APP_KEY="..."
# ADZUNA_COUNTRIES="us,gb,ca,au"   # ISO codes; gb=UK. Nigeria (ng) is not on Adzuna API.
# ADZUNA_WHAT="software engineer"
# USAJOBS_API_KEY="..."
# USAJOBS_USER_AGENT="you@example.com"
# USAJOBS_KEYWORD="software"
# Per-company ATS public boards (optional — curated defaults apply if unset):
# GREENHOUSE_BOARDS="shopify,github,stripe"
# LEVER_BOARDS="spotify,netflix"
# ASHBY_BOARDS="openai,anthropic"
# WORKABLE_BOARDS="automattic"
# INGEST_ATS_DEFAULTS="false"   # disable curated ATS defaults
# INGEST_INCLUDE_KEYED="true"   # always include ready keyed/ATS with public ingest
# Production schedule: GitHub Actions `.github/workflows/job-ingest.yml` (twice daily).
# Optional in-process API loop (default off — prefer Actions):
# JOB_INGEST_ENABLED="true"
# JOB_INGEST_INTERVAL_MS="43200000"   # 12h
# JOB_INGEST_INCLUDE_KEYED="false"   # public-only when worker is on

# Meilisearch (Wave 2) — optional; `pnpm jobs:reindex` after first start
# MEILI_HOST="http://127.0.0.1:7700"
# MEILI_API_KEY="jobmatch_meili_dev_key"
# MEILI_INDEX_JOBS="jobs"

# Wave 3 apply-assist (fill-only Playwright — never unsupervised submit)
# APPLY_AUTOMATION_FIXTURE="1"   # allow fixture fill /admin flag apply_automation_fixture
# APPLY_AUTOMATION_LIVE="1"      # allow Greenhouse/Lever/Ashby/Workable fill-only adapters

