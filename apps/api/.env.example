# API (NestJS)
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Database — shared with packages/database
DATABASE_URL="postgresql://jobmatch:jobmatch_dev@localhost:5434/jobmatch?schema=public"

# Background jobs (BullMQ). The resume-parse worker starts with the API process.
REDIS_URL="redis://localhost:6379"
# QUEUE_DRIVER="inline"  # force inline even when Redis is available

# AI service
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TIMEOUT_MS="120000"

# Clerk — must match web app (JWT verification)
CLERK_SECRET_KEY="sk_test_..."

# Resume storage (ADR-010). Relative paths resolve from the monorepo root so the
# web app and the API worker share the same files.
UPLOAD_DIR="./uploads"

# Optional S3-compatible storage (Supabase Storage / MinIO / AWS)
# S3_BUCKET="resumes"
# S3_REGION="eu-west-1"
# S3_ENDPOINT="https://<project>.storage.supabase.co/storage/v1/s3"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_FORCE_PATH_STYLE="true"

# Email (Module 17) — used by queue workers for transactional product emails.
# Without RESEND_API_KEY, messages print to the API console in development.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="AI JobMatch Copilot <onboarding@resend.dev>"
# Deep links in emails (should match the web app origin).
APP_URL="http://localhost:3000"
# APPLICATION_REMINDERS_ENABLED="false"  # disable idle-pipeline reminder sweep
# APPLICATION_REMINDER_IDLE_DAYS="7"
# APPLICATION_REMINDER_INTERVAL_MS="21600000"  # 6 hours
