# AI Service (FastAPI)
# Dev: Ollama + LiteLLM | Prod: LiteLLM → OpenAI + Anthropic

APP_ENV=development
PORT=8000

# LiteLLM configuration
LITELLM_MODEL=ollama/llama3.2
OLLAMA_API_BASE=http://localhost:11434

# Resume parsing always runs heuristic extraction. LLM enrichment is an optional
# layer that is skipped automatically when litellm or the model backend is absent.
LLM_ENRICHMENT_ENABLED=true
LLM_TIMEOUT_SECONDS=12

# Resume optimisation (Module 4). Degrades to keyword tips when the model is down.
# Cold Ollama starts are slow — 180s is a safer local default than 60s.
LLM_OPTIMIZE_ENABLED=true
LLM_OPTIMIZE_TIMEOUT_SECONDS=180
# Optional override; empty uses LITELLM_MODEL
LLM_OPTIMIZE_MODEL=

# Semantic job search. Works without the optional LLM extras by calling Ollama
# directly: pull the model with `ollama pull nomic-embed-text`.
# EMBEDDING_DIMENSIONS must match the vector(n) column on the jobs table.
# Changing the model or dimensions requires a migration and a full re-embed.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=30

# Production providers (leave empty in local dev)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS — comma-separated origins (JSON arrays also accepted)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
