# Production environment reference (do not commit real secrets)
# Copy relevant blocks into your host's secret store (Vercel / Railway / Fly).
# Validate with: ./scripts/deploy-check.sh {web|api|ai}

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&sslmode=require"
REDIS_URL="redis://default:PASSWORD@HOST:6379"
APP_URL="https://app.example.com"

# S3-compatible storage (required in production — ADR-010)
S3_BUCKET="resumes"
S3_REGION="us-west-2"
S3_ENDPOINT="https://<project>.storage.supabase.co/storage/v1/s3"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_FORCE_PATH_STYLE="true"
# RESUME_CDN_BASE_URL="https://cdn.example.com/"

# ---------------------------------------------------------------------------
# Web (Vercel) — apps/web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://app.example.com"
NEXT_PUBLIC_API_URL="https://api.example.com/api/v1"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
CLERK_WEBHOOK_SECRET="whsec_..."
AI_SERVICE_URL="https://ai.example.com"
ADMIN_EMAILS="you@example.com"
# Billing
# LEMON_SQUEEZY_* / PAYSTACK_* — see apps/web/.env.example

# ---------------------------------------------------------------------------
# API (Railway / Fly) — apps/api
# ---------------------------------------------------------------------------
PORT="4000"
NODE_ENV="production"
CORS_ORIGIN="https://app.example.com"
CLERK_SECRET_KEY="sk_live_..."
AI_SERVICE_URL="http://ai-service.internal:8000"
JOB_INGEST_ENABLED="false"
QUEUE_DRIVER="redis"

# ---------------------------------------------------------------------------
# AI service — apps/ai-service
# ---------------------------------------------------------------------------
PORT="8000"
CORS_ORIGINS="https://app.example.com,https://api.example.com"
# Prefer hosted models in production (not local Ollama):
# LITELLM_MODEL="openai/gpt-4o-mini"
# OPENAI_API_KEY="sk-..."
# UVICORN_WORKERS="2"
