// Prisma schema for AI JobMatch Copilot
// Identity is managed by Clerk; User.id = Clerk user id

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ---------------------------------------------------------------------------
// App user — mirrored from Clerk
// ---------------------------------------------------------------------------
model User {
  id            String   @id // Clerk user id (e.g. user_...)
  name          String
  email         String
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          String   @default("user")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  profile         CareerProfile?
  preferences     UserPreference?
  resumes             Resume[]
  jobInteractions     JobInteraction[]
  resumeOptimizations ResumeOptimization[]
  applicationDrafts   ApplicationDraft[]
  applications        Application[]
  subscription        Subscription?
  savedSearches       SavedSearch[]
  interviewPreps      InterviewPrep[]
  codingSessions      CodingPracticeSession[]
  coachSessions       CareerCoachSession[]
  portfolioProjects   PortfolioProject[]
  networkingContacts  NetworkingContact[]
  applyAssistSessions ApplyAssistSession[]
  adminActionLogs     AdminActionLog[]

  @@unique([email])
  @@map("user")
}

// ---------------------------------------------------------------------------
// User Preferences — theme, locale, notifications, onboarding
// ---------------------------------------------------------------------------
model UserPreference {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme    String @default("system") // system | light | dark
  locale   String @default("en") // en | es | fr | de
  timezone String @default("UTC")

  emailJobAlerts          Boolean @default(true) @map("email_job_alerts")
  emailApplicationUpdates Boolean @default(true) @map("email_application_updates")
  emailWeeklyDigest       Boolean @default(true) @map("email_weekly_digest")
  emailMarketing          Boolean @default(false) @map("email_marketing")
  pushEnabled             Boolean @default(false) @map("push_enabled")

  /// Last successful weekly digest send (Wave 1).
  lastWeeklyDigestAt DateTime? @map("last_weekly_digest_at")

  onboardingCompleted Boolean @default(false) @map("onboarding_completed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

// ---------------------------------------------------------------------------
// Career Profile — Module 2 foundation
// ---------------------------------------------------------------------------
model CareerProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline String?
  summary  String? @db.Text

  phone    String?
  address  String?
  city     String?
  country  String?
  timeZone String? @map("time_zone")

  portfolioUrl String? @map("portfolio_url")
  githubUrl    String? @map("github_url")
  linkedinUrl  String? @map("linkedin_url")
  websiteUrl   String? @map("website_url")

  currentJobTitle        String?  @map("current_job_title")
  yearsOfExperience      Int?     @map("years_of_experience")
  desiredRoles           String[] @default([]) @map("desired_roles")
  employmentType         String?  @map("employment_type")
  salaryExpectation      Int?     @map("salary_expectation")
  salaryCurrency         String?  @default("USD") @map("salary_currency")
  noticePeriodDays       Int?     @map("notice_period_days")
  workAuthorization      String?  @map("work_authorization")
  visaSponsorshipNeeded  Boolean  @default(false) @map("visa_sponsorship_needed")
  workLocationPreference String?  @map("work_location_preference")

  completenessScore Int @default(0) @map("completeness_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skills Skill[]

  @@map("career_profiles")
}

model Skill {
  id        String        @id @default(cuid())
  profileId String        @map("profile_id")
  profile   CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name     String
  category String
  level    String?
  years    Int?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([profileId])
  @@map("skills")
}

// ---------------------------------------------------------------------------
// Resumes — Module 3
// ---------------------------------------------------------------------------
model Resume {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title            String
  originalFileName String  @map("original_file_name")
  mimeType         String  @map("mime_type")
  fileSize         Int     @map("file_size")
  storageKey       String  @map("storage_key")
  storageProvider  String  @default("local") @map("storage_provider") // local | s3
  isPrimary        Boolean @default(false) @map("is_primary")

  /// idle | queued | processing | ready | failed
  parseStatus String  @default("idle") @map("parse_status")
  parseError  String? @map("parse_error")
  parsedText  String? @map("parsed_text") @db.Text
  parsedJson  Json?   @map("parsed_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions           ResumeVersion[]
  optimizations      ResumeOptimization[]
  applicationDrafts  ApplicationDraft[]
  applications       Application[]

  @@index([userId])
  @@index([userId, isPrimary])
  @@map("resumes")
}

model ResumeVersion {
  id       String @id @default(cuid())
  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  label       String
  /// upload | optimized | manual
  source      String  @default("upload")
  contentText String? @map("content_text") @db.Text
  contentJson Json?   @map("content_json")

  createdAt DateTime @default(now()) @map("created_at")

  optimization ResumeOptimization?

  @@index([resumeId])
  @@map("resume_versions")
}

/// Phase 2 Module 4 — tailor a resume to a job with before/after keyword-fit scores.
model ResumeOptimization {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId    String @map("job_id")
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// queued | processing | ready | failed
  status String  @default("queued")
  error  String?

  beforeScore Int? @map("before_score")
  afterScore  Int? @map("after_score")
  resultJson  Json? @map("result_json")

  versionId String?        @unique @map("version_id")
  version   ResumeVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([resumeId, jobId])
  @@index([status])
  @@map("resume_optimizations")
}

/// Phase 2 Module 9 — cover letter + short application answers for a job.
model ApplicationDraft {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId    String @map("job_id")
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// queued | processing | ready | failed
  status String  @default("queued")
  error  String?

  coverLetter String? @map("cover_letter") @db.Text
  /// Input prompts (string[]) used for generation
  questions   Json?
  /// [{ question, answer }]
  answers     Json?
  resultJson  Json? @map("result_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application?

  @@index([userId, createdAt])
  @@index([resumeId, jobId])
  @@index([status])
  @@map("application_drafts")
}

/// Phase 2 Module 11 — pipeline tracker for a user↔job application.
model Application {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String @map("job_id")
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// ApplicationStage vocabulary from @jobmatch/types
  stage String @default("preparing")
  notes String? @db.Text

  /// Last Module 17 reminder email (stale pipeline nudge).
  lastReminderAt DateTime? @map("last_reminder_at")

  resumeId String? @map("resume_id")
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  draftId String?           @unique @map("draft_id")
  draft   ApplicationDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  applyAssist ApplyAssistSession?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, jobId])
  @@index([userId, stage])
  @@index([jobId])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// Job Discovery — Module 5
// ---------------------------------------------------------------------------
model Company {
  id   String @id @default(cuid())
  name String
  slug String @unique

  websiteUrl String? @map("website_url")
  logoUrl    String? @map("logo_url")
  industry   String?
  /// 1-10 | 11-50 | 51-200 | 201-500 | 501-1000 | 1001-5000 | 5000+
  size       String?
  location   String?
  about      String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobs               Job[]
  networkingContacts NetworkingContact[]

  @@map("companies")
}

model Job {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  slug        String @unique
  description String @db.Text

  responsibilities String[] @default([])
  requirements     String[] @default([])
  benefits         String[] @default([])
  skills           String[] @default([])

  /// Vocabularies match CareerProfile so Module 6 can compare them directly.
  /// full-time | part-time | contract | freelance | internship
  employmentType String @default("full-time") @map("employment_type")
  /// remote | hybrid | on-site
  workMode       String @default("on-site") @map("work_mode")
  /// intern | junior | mid | senior | lead | principal
  seniority      String @default("mid")

  location String?
  city     String?
  country  String?

  salaryMin      Int?   @map("salary_min")
  salaryMax      Int?   @map("salary_max")
  salaryCurrency String @default("USD") @map("salary_currency")
  /// year | month | day | hour
  salaryPeriod   String @default("year") @map("salary_period")

  /// seed | remotive | himalayas | jobicy | arbeitnow | remoteok | adzuna | usajobs | greenhouse | lever | ashby | workable | manual
  source     String  @default("seed")
  sourceUrl  String? @map("source_url")
  externalId String? @map("external_id")
  applyUrl   String? @map("apply_url")

  postedAt  DateTime  @default(now()) @map("posted_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")

  /// Semantic search vector. Written via raw SQL; pgvector types are not
  /// representable in the Prisma client.
  embedding Unsupported("vector(768)")?

  /// idle | queued | processing | ready | failed
  embeddingStatus String    @default("idle") @map("embedding_status")
  embeddingError  String?   @map("embedding_error")
  embeddingModel  String?   @map("embedding_model")
  embeddedAt      DateTime? @map("embedded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  interactions       JobInteraction[]
  optimizations      ResumeOptimization[]
  applicationDrafts  ApplicationDraft[]
  applications       Application[]
  interviewPreps     InterviewPrep[]
  codingSessions     CodingPracticeSession[]

  @@unique([source, externalId])
  @@index([companyId])
  @@index([isActive, postedAt])
  @@index([embeddingStatus])
  @@map("jobs")
}

model JobInteraction {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String @map("job_id")
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// saved | viewed | dismissed
  type  String
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, jobId, type])
  @@index([userId, type])
  @@index([jobId])
  @@map("job_interactions")
}

// ---------------------------------------------------------------------------
// Saved searches & job alerts — Module 5 (Phase 3)
// ---------------------------------------------------------------------------
model SavedSearch {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Display name, e.g. "Remote senior React"
  name String
  /// JobSearchParams JSON (q, workMode, employmentType, seniority, country, salaryMin, sort)
  query Json

  /// When true, the alert worker emails new matching jobs (also gated by emailJobAlerts).
  alertEnabled Boolean @default(true) @map("alert_enabled")
  /// Last successful alert send for this saved search.
  lastAlertAt DateTime? @map("last_alert_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, alertEnabled])
  @@index([alertEnabled, lastAlertAt])
  @@map("saved_searches")
}

// ---------------------------------------------------------------------------
// Billing — Module 19 (Lemon Squeezy global + Paystack Nigeria)
// ---------------------------------------------------------------------------
model Subscription {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// free | pro (pro while status is active/on_trial)
  planId String @default("free") @map("plan_id")
  /// active | on_trial | past_due | canceled | expired | inactive
  status String @default("inactive")
  /// lemon_squeezy | paystack
  provider String?

  providerCustomerId     String? @map("provider_customer_id")
  providerSubscriptionId String? @unique @map("provider_subscription_id")
  providerVariantId      String? @map("provider_variant_id")

  currentPeriodEnd  DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  rawMeta           Json?     @map("raw_meta")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([provider, status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Interview preparation — Module 12
// ---------------------------------------------------------------------------
model InterviewPrep {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String @map("job_id")
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// ready | practicing | completed
  status String @default("ready")

  /// InterviewQuestionCategory[] selected for this session
  categories String[] @default([])

  /// InterviewQuestionDto[]
  questionsJson Json @map("questions_json")
  /// InterviewPracticeEntryDto[] — self ratings / notes
  practiceJson  Json? @map("practice_json")

  /// 0–100 from practice self-ratings + coverage
  confidenceScore Int? @map("confidence_score")

  summary String? @db.Text
  /// template | llm
  source  String  @default("template")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([userId, jobId])
  @@index([jobId])
  @@map("interview_preps")
}

// ---------------------------------------------------------------------------
// Coding assessment prep — Module 13
// ---------------------------------------------------------------------------
model CodingPracticeSession {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional — company/role-specific packs when started from a job
  jobId  String? @map("job_id")
  job    Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// ready | practicing | completed
  status String @default("ready")

  /// CodingProblemStyle[] included in this pack
  styles String[] @default([])
  /// easy | medium | hard filters used
  difficulties String[] @default([])

  /// CodingProblemDto[]
  problemsJson Json @map("problems_json")
  /// CodingAttemptDto[]
  attemptsJson Json? @map("attempts_json")

  /// 0–100 aggregate from attempts
  performanceScore Int? @map("performance_score")
  /// Total timed minutes budget across problems
  timeBudgetMinutes Int? @map("time_budget_minutes")

  summary String? @db.Text
  /// template | llm
  source  String  @default("template")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([userId, jobId])
  @@index([jobId])
  @@map("coding_practice_sessions")
}

// ---------------------------------------------------------------------------
// AI Career Coach — Module 16
// ---------------------------------------------------------------------------
model CareerCoachSession {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// active | archived
  status String @default("active")
  /// skill_gaps | roadmap | salary | promotion | career_path | general
  focus  String @default("general")
  title  String?

  /// CoachMessageDto[]
  messagesJson Json @map("messages_json")
  /// Slim growth-hub snapshot used for coaching context
  contextJson  Json? @map("context_json")

  summary String? @db.Text
  /// template | llm — last assistant reply source
  source  String  @default("template")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("career_coach_sessions")
}

// ---------------------------------------------------------------------------
// Portfolio & Project Builder — Module 14
// ---------------------------------------------------------------------------
model PortfolioProject {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  summary String? @db.Text
  role    String?

  /// draft | in_progress | shipped | archived
  status String @default("draft")

  techStack  String[] @default([]) @map("tech_stack")
  highlights String[] @default([])

  problem  String? @db.Text
  solution String? @db.Text
  impact   String? @db.Text

  repoUrl String? @map("repo_url")
  demoUrl String? @map("demo_url")

  startMonth String? @map("start_month")
  endMonth   String? @map("end_month")

  isFeatured Boolean @default(false) @map("is_featured")
  sortOrder  Int     @default(0) @map("sort_order")

  /// manual | suggested
  source         String  @default("manual")
  suggestedSkill String? @map("suggested_skill")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, sortOrder])
  @@index([userId, createdAt])
  @@map("portfolio_projects")
}

// ---------------------------------------------------------------------------
// Professional Networking — Module 8 (public data only)
// ---------------------------------------------------------------------------
model NetworkingContact {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Optional link to a catalog company
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// Free-text company label when not linked (or display override)
  companyName String? @map("company_name")

  fullName String  @map("full_name")
  /// recruiter | hiring_manager | engineer | founder | other
  roleType String  @default("recruiter") @map("role_type")
  title    String?

  /// Public URLs only (LinkedIn profile URL user pastes, company site, etc.)
  profileUrl String? @map("profile_url")
  email      String?

  /// to_contact | researched | reached_out | conversing | closed
  status String @default("to_contact")
  notes  String? @db.Text

  /// Optional job this outreach relates to
  relatedJobId String? @map("related_job_id")

  lastTouchedAt DateTime? @map("last_touched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([companyId])
  @@map("networking_contacts")
}

// ---------------------------------------------------------------------------
// Smart Application Automation — Module 10 (user-approved assist)
// ---------------------------------------------------------------------------
model ApplyAssistSession {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String      @unique @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// ready | opened | fill_approved | submitted | cancelled
  status String @default("ready")

  /// ApplyChecklistItemDto[]
  checklistJson Json @map("checklist_json")
  /// ApplyFillFieldDto[] — values the user approved Playwright (or manual paste) may use
  fillPlanJson  Json @map("fill_plan_json")

  openedAt       DateTime? @map("opened_at")
  fillApprovedAt DateTime? @map("fill_approved_at")
  submittedAt    DateTime? @map("submitted_at")
  submitNote     String?   @map("submit_note") @db.Text

  /// skipped | approved_pending | fixture_ran | blocked
  playwrightStatus String  @default("skipped") @map("playwright_status")
  playwrightDetail String? @map("playwright_detail") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("apply_assist_sessions")
}

// ---------------------------------------------------------------------------
// Admin Portal — Module 20
// ---------------------------------------------------------------------------
model AppFeatureFlag {
  id          String  @id @default(cuid())
  key         String  @unique
  enabled     Boolean @default(false)
  description String? @db.Text
  updatedBy   String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_feature_flags")
}

model AdminActionLog {
  id          String  @id @default(cuid())
  actorUserId String  @map("actor_user_id")
  actor       User    @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  /// e.g. user.role_update | flag.set
  action     String
  targetType String  @map("target_type")
  targetId   String? @map("target_id")
  detail     Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("admin_action_logs")
}

