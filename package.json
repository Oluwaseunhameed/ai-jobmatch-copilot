{
  "name": "ai-jobmatch-copilot",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:ai": "pnpm --filter @jobmatch/ai-service run dev",
    "setup:ai": "pnpm --filter @jobmatch/ai-service run bootstrap",
    "test:ai": "pnpm --filter @jobmatch/ai-service run py:test",
    "eval:ai": "pnpm --filter @jobmatch/ai-service run py:eval",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @jobmatch/database db:generate",
    "db:migrate": "pnpm --filter @jobmatch/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @jobmatch/database db:migrate:deploy",
    "db:push": "pnpm --filter @jobmatch/database db:push",
    "db:seed": "pnpm --filter @jobmatch/database db:seed",
    "jobs:embed": "pnpm --filter @jobmatch/job-search jobs:embed",
    "jobs:ingest": "pnpm --filter @jobmatch/job-search jobs:ingest",
    "jobs:purge-seed": "pnpm --filter @jobmatch/job-search jobs:purge-seed",
    "jobs:reindex": "pnpm --filter @jobmatch/job-search jobs:reindex",
    "db:studio": "pnpm --filter @jobmatch/database db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@jobmatch/typescript-config": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },

  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
